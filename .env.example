# Omnesight Sentinel — Sovereign Operational Intelligence Runtime
# Environment Configuration Template (DO NOT COMMIT REAL SECRETS)

# Meta Model API Key (Obtain from https://dev.meta.ai)
META_LLM_KEY=your_meta_model_api_key_here

# Meta Model Name (e.g. muse-spark-1.3, Llama-3.2-11B-Vision-Instruct)
META_MODEL=muse-spark-1.3

# Sovereign Enclave HMAC Secret Key (Used for cryptographic sign-off sealing)
SENTINEL_HMAC_SECRET=generate_a_secure_random_enclave_secret_here

# Physical Hardware Security Key / Supervisor PIN (4 digits)
SUPERVISOR_HARDWARE_PIN=8765

# Optional: Offline Fallback for automated CI/CD unit testing (0 = False, 1 = True)
ALLOW_OFFLINE_FALLBACK=0

